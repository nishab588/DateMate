<?xml version="1.0" encoding="utf-8"?>

<!--
    Add Event screen for Date Mate.
    Collects the information required to create and save a new event.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/addEventContent"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp">

    <!-- Groups the navigation control and centered screen title. -->
    <LinearLayout
        android:id="@+id/layoutHeader"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Opens the navigation menu containing the primary app destinations. -->
        <ImageButton
            android:id="@+id/buttonMenu"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Open navigation menu"
            android:padding="12dp"
            android:src="@drawable/ic_menu" />

        <!-- Identifies the purpose of the current screen. -->
        <TextView
            android:id="@+id/textAddEventTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Add Event"
            android:textSize="28sp"
            android:textStyle="bold" />

        <!-- Balances the menu control so the screen title remains centered. -->
        <Space
            android:layout_width="48dp"
            android:layout_height="48dp" />

    </LinearLayout>

    <!-- Accepts the name used to identify the event. -->
    <EditText
        android:id="@+id/editEventName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="Event name"
        android:inputType="textCapSentences"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutHeader" />

    <!-- Opens a date-selection control for the scheduled event date. -->
    <Button
        android:id="@+id/buttonSelectDate"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Select Date"
        app:layout_constraintEnd_toStartOf="@id/buttonSelectTime"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/editEventName" />

    <!-- Opens a time-selection control for the scheduled event time. -->
    <Button
        android:id="@+id/buttonSelectTime"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="Select Time"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/buttonSelectDate"
        app:layout_constraintTop_toTopOf="@id/buttonSelectDate" />

    <!-- Displays the date selected by the user. -->
    <TextView
        android:id="@+id/textSelectedDate"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Date: Not selected"
        android:textSize="16sp"
        app:layout_constraintEnd_toStartOf="@id/textSelectedTime"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/buttonSelectDate" />

    <!-- Displays the time selected by the user. -->
    <TextView
        android:id="@+id/textSelectedTime"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="Time: Not selected"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/textSelectedDate"
        app:layout_constraintTop_toTopOf="@id/textSelectedDate" />

    <!-- Accepts the physical or virtual location of the event. -->
    <EditText
        android:id="@+id/editEventLocation"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="Location"
        android:inputType="textCapWords"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textSelectedDate" />

    <!-- Accepts optional details or notes about the event. -->
    <EditText
        android:id="@+id/editEventDescription"
        android:layout_width="0dp"
        android:layout_height="100dp"
        android:layout_marginTop="12dp"
        android:gravity="top|start"
        android:hint="Description or notes"
        android:inputType="textCapSentences|textMultiLine"
        android:padding="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/editEventLocation" />

    <!-- Controls whether reminder notifications are requested for the event. -->
    <CheckBox
        android:id="@+id/checkEventReminder"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:checked="true"
        android:text="Send event reminders"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/editEventDescription" />

    <!-- Saves the event information entered by the user. -->
    <Button
        android:id="@+id/buttonSaveEvent"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Save Event"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/checkEventReminder" />

    <!-- Provides access to assistance from the Add Event screen. -->
    <Button
        android:id="@+id/buttonHelp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="Open help"
        android:text="Help"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>