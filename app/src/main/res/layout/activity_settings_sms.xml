<?xml version="1.0" encoding="utf-8"?>

<!--
    Settings screen for Date Mate.
    Explains the SMS notification feature and allows the user to
    grant or deny permission without affecting the rest of the app.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/settingsContent"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp">

    <!-- Groups the navigation control and centered screen title. -->
    <LinearLayout
        android:id="@+id/layoutHeader"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Opens the navigation menu containing the available app destinations. -->
        <ImageButton
            android:id="@+id/buttonMenu"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Open navigation menu"
            android:padding="12dp"
            android:src="@drawable/ic_menu" />

        <!-- Identifies the purpose of the current screen. -->
        <TextView
            android:id="@+id/textSettingsTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Settings"
            android:textSize="28sp"
            android:textStyle="bold" />

        <!-- Balances the menu control so the screen title remains centered. -->
        <Space
            android:layout_width="48dp"
            android:layout_height="48dp" />

    </LinearLayout>

    <!-- Identifies the notification-permission settings section. -->
    <TextView
        android:id="@+id/textSmsHeading"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="36dp"
        android:gravity="center"
        android:text="SMS Event Notifications"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutHeader" />

    <!-- Explains why the application requests access to SMS messaging. -->
    <TextView
        android:id="@+id/textSmsExplanation"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:text="DateMate can send SMS reminders 24 hours before an event and again on the day of the event."
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textSmsHeading" />

    <!-- Displays the application's current SMS permission status. -->
    <TextView
        android:id="@+id/textPermissionStatus"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:background="#E8EAF6"
        android:gravity="center"
        android:padding="16dp"
        android:text="SMS permission status: Not granted"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textSmsExplanation" />

    <!-- Displays the phone number currently used for SMS reminders. -->
    <TextView
        android:id="@+id/textSavedPhoneNumber"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:text="No phone number saved"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textPermissionStatus" />

    <!-- Allows the user to change the saved SMS reminder number. -->
    <Button
        android:id="@+id/buttonEditPhoneNumber"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Edit Phone Number"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textSavedPhoneNumber" />

    <!-- Sends a test reminder immediately for emulator testing. -->
    <Button
        android:id="@+id/buttonTestSms"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Send Test SMS Reminder"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/buttonEditPhoneNumber" />

    <!-- Triggers the Android system request for SMS permission. -->
    <Button
        android:id="@+id/buttonEnableSms"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:contentDescription="Enable SMS event notifications"
        android:text="Enable SMS Notifications"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/buttonTestSms" />

    <!-- Allows the user to continue using the app without SMS notifications. -->
    <Button
        android:id="@+id/buttonContinueWithoutSms"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:contentDescription="Continue without SMS notifications"
        android:text="Continue Without Notifications"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/buttonEnableSms" />

    <!-- Clarifies that denying SMS permission does not disable other features. -->
    <TextView
        android:id="@+id/textSmsOptionalNotice"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:text="SMS permission is optional. DateMate will continue to function if permission is denied, but event reminders will not be sent."
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/buttonContinueWithoutSms" />

    <!-- Provides access to assistance from the Settings screen. -->
    <Button
        android:id="@+id/buttonHelp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="Open help"
        android:text="Help"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>